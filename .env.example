# Leave local for an offline preview using the two original articles.
BLOG_CONTENT_SOURCE=local
SITE_URL=https://yohoia.cn

# Optional PageHush backend, server-only. Use SELECT-only database permissions.
# BLOG_CONTENT_SOURCE=pagehush
BLOG_DATABASE_URL=
# Read-only MinIO/S3 credentials for images referenced by published articles.
BLOG_S3_ENDPOINT=
BLOG_S3_REGION=us-east-1
BLOG_S3_BUCKET=
BLOG_S3_ACCESS_KEY_ID=
BLOG_S3_SECRET_ACCESS_KEY=
