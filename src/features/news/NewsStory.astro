---
import { ArrowUpRight } from '@lucide/astro';
import { iconTokens } from '@/config/icons';
import type { Locale } from '@/config/i18n';
import type { NewsItem } from './types';
import {
  formatNewsTime,
  newsContent,
  newsTextLanguage,
  newsTitle,
} from './config';

interface Props {
  item?: NewsItem;
  locale: Locale;
  mode: 'lead' | 'secondary' | 'brief' | 'short';
}
const { item, locale, mode } = Astro.props;
const text = newsContent[locale];
const title = item ? newsTitle(item, locale) : '';
const Heading = mode === 'lead' ? 'h2' : 'h3';
---

<article
  class={`news-story news-story--${mode}`}
  data-news-story
  data-language-block={item ? `news-${item.id}` : undefined}
  data-attribution={item?.attribution.name}
  data-canonical={item?.attribution.url}
>
  <div class="news-story-header">
    <div class="news-story-tags" aria-label={text.selected}>
      <span class="news-chip" hidden={!item?.selected} data-story-selected>
        {text.selected}
      </span>
      <span class="news-chip" hidden={item?.score == null} data-story-score>
        AI {item?.score}/100
      </span>
    </div>
    <a
      href={item?.url}
      class="news-read-link"
      target="_blank"
      rel="noopener noreferrer"
      data-story-original
    >
      {text.original}
      <ArrowUpRight
        size={iconTokens.size.small}
        stroke-width={iconTokens.strokeWidth}
        aria-hidden="true"
      />
    </a>
  </div>
  <a
    class="news-story-title"
    href={item?.readingUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-story-reading
  >
    <Heading
      lang={newsTextLanguage(title)}
      title={title || undefined}
      data-story-title
    >
      {title}
    </Heading>
  </a>
  <p
    class="news-story-summary"
    hidden={!item?.summary}
    lang={newsTextLanguage(item?.summary ?? '')}
    title={item?.summary}
    data-story-summary
  >
    {item?.summary}
  </p>
  <div class="news-story-footer">
    <div class="news-story-meta micro-label">
      <time
        datetime={item?.publishedAt ?? undefined}
        hidden={!item?.publishedAt}
        data-story-time
      >
        {item?.publishedAt && formatNewsTime(item.publishedAt, locale)}
      </time>
      <span hidden={!!item?.publishedAt} data-story-unknown>
        {text.unknownDate}
      </span>
      <span class="news-meta-separator" aria-hidden="true"></span>
      <span
        class="news-source"
        lang={newsTextLanguage(item?.source.name ?? '')}
        data-story-source
      >
        {item?.source.name}
      </span>
    </div>
  </div>
</article>
