---
import { RefreshCw } from '@lucide/astro';
import Container from '@/components/layout/Container.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { iconTokens } from '@/config/icons';
import { getLocale, localizePath } from '@/lib/i18n';
import {
  newsContent,
  newsFilters,
  formatCalendarDate,
  formatCalendarWeekday,
  formatNewsTime,
} from './config';
import { newsCategories } from '@/config/categories';
import { buildHeatmap } from './calendar';
import { getNewsSnapshot } from './snapshot';
import NewsStory from './NewsStory.astro';
import './news.css';

const locale = getLocale(Astro.url.pathname);
const text = newsContent[locale];
const snapshot = await getNewsSnapshot();
const daily = snapshot.daily;
const items = daily?.articles ?? snapshot.page.items;
const serialized = JSON.stringify(snapshot).replace(/</g, '\\u003c');
const selectedDate = daily?.date;
const heatmap = buildHeatmap(
  selectedDate ?? new Date().toISOString().slice(0, 10),
  snapshot.archive.map((entry) => entry.date),
  'daily',
  locale,
  selectedDate ?? null,
);
const selectedArchiveIndex = selectedDate
  ? snapshot.archive.findIndex((entry) => entry.date === selectedDate)
  : -1;
const issueNumber =
  selectedDate && selectedArchiveIndex >= 0
    ? snapshot.archiveTotal - selectedArchiveIndex
    : null;
const dailyLead = items[0];
---

<SiteLayout title="News" description={text.description}>
  <Container as="main" id="main-content" width="wide" class="news-paper">
    <news-paper data-locale={locale}>
      <header
        class="news-edition-top micro-label"
        data-language-block="news-edition"
      >
        <div
          class="news-edition-selected"
          data-news-edition-details
          hidden={!daily}
        >
          <p class="news-edition-issue">
            <span>{text.issue}</span>
            <span data-news-issue>{issueNumber}</span>
            {locale === 'zh' && <span>{text.issueUnit}</span>}
          </p>
          <p class="news-edition-date">
            <time
              datetime={selectedDate}
              data-news-selected-date
              data-news-month-target
            >
              {selectedDate && formatCalendarDate(selectedDate, locale)}
            </time>
            <span class="news-meta-separator" aria-hidden="true"></span>
            <span data-news-selected-weekday>
              {selectedDate && formatCalendarWeekday(selectedDate, locale)}
            </span>
          </p>
        </div>
        <div class="news-refresh-meta">
          <time
            datetime={snapshot.fetchedAt ?? undefined}
            title={text.timezone}
            data-news-fetched
            hidden={!snapshot.fetchedAt || !!daily}
          >
            <span data-news-fetched-value>
              {snapshot.fetchedAt &&
                `${text.updated} ${formatNewsTime(snapshot.fetchedAt, locale)}`}
            </span>
            <span class="news-timezone"> · {text.timezone}</span>
          </time>
          <span data-news-report-meta hidden={!daily}>
            <time
              datetime={daily?.generatedAt}
              data-news-generated
              title={text.timezone}
            >
              {daily &&
                `${text.generated} ${formatNewsTime(daily.generatedAt, locale)}`}
            </time>
            <span aria-hidden="true"> · </span>
            <span data-news-period>
              {daily &&
                `${text.period} ${formatNewsTime(daily.windowStart, locale)} — ${formatNewsTime(daily.windowEnd, locale)} · ${text.timezone}`}
            </span>
          </span>
          <button
            class="news-refresh"
            type="button"
            aria-label={text.refresh}
            title={text.refresh}
            data-news-refresh
            data-news-controls
            hidden
          >
            <RefreshCw
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
          </button>
        </div>
      </header>

      <p
        class="news-status text-meta"
        role="status"
        aria-live="polite"
        data-news-status
        hidden
      ></p>
      <h1 class="sr-only">News</h1>
      <div class="news-content" aria-busy="false" data-news-paper-content>
        <p
          class="news-empty text-meta"
          data-news-empty
          hidden={items.length > 0}
        >
          {text.unavailable}
        </p>
        <div class="news-front-layout" data-news-front>
          <div class="news-front-main">
            <div data-news-lead>
              {dailyLead && (
                <NewsStory item={dailyLead} locale={locale} mode="lead" />
              )}
            </div>
            <div
              class="news-secondary-grid"
              data-news-secondary
              hidden={items.length < 2}
            >
              {items.slice(1, 3).map((item) => (
                <NewsStory item={item} locale={locale} mode="secondary" />
              ))}
            </div>
          </div>
          <aside class="news-rail">
            <section
              class="news-heatmap"
              aria-label={text.calendar}
              hidden={!selectedDate}
            >
              <header class="news-heatmap-header">
                <p class="news-heatmap-title">
                  <span aria-hidden="true"></span>SIGNAL ACTIVITY
                </p>
                <div
                  class="news-heatmap-controls"
                  role="group"
                  aria-label={text.calendarRange}
                >
                  {(['daily', 'weekly', 'monthly'] as const).map((mode) => (
                    <button
                      type="button"
                      class="news-heatmap-tab"
                      disabled
                      aria-pressed={mode === 'daily' ? 'true' : 'false'}
                      data-news-heatmap-mode={mode}
                    >
                      {locale === 'zh'
                        ? { daily: '日报', weekly: '周报', monthly: '月报' }[
                            mode
                          ]
                        : {
                            daily: 'Daily',
                            weekly: 'Weekly',
                            monthly: 'Monthly',
                          }[mode]}
                    </button>
                  ))}
                </div>
              </header>
              <div
                class="news-heatmap-body"
                data-news-heatmap-body
                data-news-heatmap-mode="daily"
                style={`--heatmap-rows: ${heatmap.rows}; --heatmap-columns: ${heatmap.columns}`}
              >
                <div
                  class="news-heatmap-axis"
                  data-news-heatmap-axis
                  aria-hidden="true"
                >
                  {heatmap.axis.map((label) => (
                    <span>{label}</span>
                  ))}
                </div>
                <div class="news-heatmap-scroll">
                  <div class="news-heatmap-grid" data-news-heatmap-grid>
                    {heatmap.cells.map((cell) =>
                      cell.displayDate ? (
                        <button
                          class="news-heat-cell"
                          type="button"
                          disabled={!cell.date}
                          data-news-date={cell.date ?? undefined}
                          data-news-heat-display-date={cell.displayDate}
                          data-news-heat-key={cell.key}
                          data-news-heat-level={cell.level}
                          aria-pressed={cell.selected}
                          aria-label={cell.label}
                          title={cell.label}
                        ></button>
                      ) : (
                        <span
                          class="news-heat-cell"
                          data-news-heat-level="0"
                          title={cell.label || undefined}
                          aria-hidden="true"
                        ></span>
                      ),
                    )}
                  </div>
                </div>
              </div>
              <footer class="news-heatmap-footer">
                <span data-news-heatmap-period>{heatmap.period}</span>
              </footer>
              <div
                class="news-heat-tooltip"
                role="tooltip"
                id="news-heat-tooltip"
                data-news-heat-tooltip
                hidden
              ></div>
            </section>
            <nav
              class="news-category-tabs news-editorial-nav"
              aria-label={text.filters}
            >
              {newsFilters.map((category, index) => (
                <button
                  type="button"
                  disabled
                  aria-pressed={category === 'all' ? 'true' : 'false'}
                  data-news-category={category}
                  data-news-target={`news-section-${category}`}
                >
                  <span class="news-editorial-num">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="news-editorial-text">
                    {text.categories[category]}
                  </span>
                  <span
                    class="news-tab-count news-editorial-count"
                    data-news-category-count
                    aria-hidden={category !== 'all' || !snapshot.fetchedAt}
                  >
                    {category === 'all' ? items.length : ''}
                  </span>
                </button>
              ))}
            </nav>
          </aside>
        </div>
        <div
          id="news-section-all"
          class="news-section-list"
          data-news-sections
          data-news-content
          aria-busy="false"
        >
          {newsCategories.map((category) => {
            const entries = items
              .slice(3)
              .filter((item) => item.category === category);
            return (
              <section
                id={`news-section-${category}`}
                class="news-section"
                data-news-section={category}
                hidden={!entries.length}
                aria-labelledby={`news-section-${category}-title`}
              >
                <div class="news-section-heading">
                  <h2 id={`news-section-${category}-title`}>
                    {text.categories[category]}
                  </h2>
                  <span class="micro-label" data-news-section-count>
                    {entries.length} {text.stories}
                  </span>
                </div>
                <div class="news-section-grid" data-news-section-grid>
                  {entries.map((item) => (
                    <NewsStory item={item} locale={locale} mode="short" />
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </div>
      <div class="news-pagination" data-news-controls hidden>
        <button
          class="news-more"
          type="button"
          data-news-more
          hidden={!!daily || !snapshot.page.hasMore}
        >
          {text.more}
          <span aria-hidden="true"> ↓</span>
        </button>
      </div>

      <footer class="news-footer" data-language-block="news-footer">
        <a
          class="news-home font-mono text-meta"
          href={localizePath('/', locale)}
          data-astro-reload
          aria-label={text.home}
        >
          cd ../
        </a>
      </footer>
      <script
        type="application/json"
        data-news-snapshot
        set:html={serialized}
      />
      {(['lead', 'secondary', 'short'] as const).map((mode) => (
        <template data-news-template={mode}>
          <NewsStory locale={locale} mode={mode} />
        </template>
      ))}
    </news-paper>
  </Container>
</SiteLayout>

<script>
  import { registerNewsPaper } from '@/scripts/news';
  registerNewsPaper();
</script>
