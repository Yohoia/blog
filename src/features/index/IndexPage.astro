---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Terminal from '@/features/index/Terminal.astro';
import Container from '@/components/layout/Container.astro';
import { getLocale } from '@/lib/i18n';
import { ui } from '@/i18n/ui';
import { terminalLabels } from './config';

const locale = getLocale(Astro.url.pathname);
---

<SiteLayout title={ui[locale].navigation.index}>
  <script slot="head" is:inline>
    if (performance.getEntriesByType('navigation')[0]?.type === 'reload') {
      document.documentElement.dataset.terminalJs = 'true';
    }
  </script>
  <Container as="main" width="index" id="main-content" class="index-page">
    <h1 class="sr-only">{terminalLabels[locale].title}</h1>
    <Terminal />
  </Container>
</SiteLayout>

<style>
  .index-page {
    padding-block: var(--group-gap) var(--section-gap);
  }
</style>
