---
import { siteConfig } from '@/config/site';
import { sectionPaths } from '@/config/navigation';
import { getLocale, localizePath } from '@/lib/i18n';
import { getPublishedEntries, sortByDate } from '@/lib/content/queries';
import TerminalPrompt from './TerminalPrompt.astro';
import TerminalContacts from './TerminalContacts.astro';
import PixelAvatar from './PixelAvatar.astro';
import { terminalContent, terminalLabels, terminalSequence } from './config';

const locale = getLocale(Astro.url.pathname);
const labels = terminalLabels[locale];
const username = siteConfig.name.toLowerCase();
const latestPosts = sortByDate(
  await getPublishedEntries('blog'),
  (entry) => entry.data.publishedAt,
)
  .slice(0, terminalContent.posts.limit)
  .reverse()
  .map((entry) => ({
    filename: entry.filePath?.split('/').at(-1) ?? `${entry.id}.md`,
    anchor: entry.id,
    date: new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: '2-digit',
      timeZone: 'UTC',
    }).format(entry.data.publishedAt),
  }));
const blogUrl = localizePath(sectionPaths.blog, locale);
---

<yohoia-terminal class="index-introduction" data-language-block="introduction">
  <div
    class="introduction-content"
    data-terminal-body
    role="region"
    aria-label={labels.output}
    aria-live="off"
  >
    <p class="last-login c-muted">
      Last login:{' '}
      <time data-terminal-login title={labels.dateFallback}>
        —
      </time>{' '}
      on ttys001
    </p>

    <div data-terminal-history>
      {terminalSequence.map((step) => (
        <div
          class="introduction-section"
          data-terminal-step
          data-command={step.command}
        >
          <div class:list={{ 'identity-layout': step.id === 'identity' }}>
            <div>
              <div class="prompt-line">
                <TerminalPrompt />
                <span class="cmd-text">{step.command}</span>
              </div>

              {step.id === 'identity' && (
                <div
                  class="output-block identity-copy"
                  lang="en"
                  data-terminal-output
                >
                  <p class="terminal-name c-white">{siteConfig.name}</p>
                  <p class="c-muted">{terminalContent.identity.role}</p>
                  <p class="c-muted">{terminalContent.identity.experience}</p>
                  <p class="c-muted">{terminalContent.identity.location}</p>
                </div>
              )}

              {step.id === 'philosophy' && (
                <div class="output-block" data-terminal-output>
                  <p class="philosophy c-orange" lang="zh-CN">
                    {terminalContent.philosophy.zh}
                  </p>
                  <div class="c-muted" lang="en">
                    {terminalContent.philosophy.en.map((line) => (
                      <p>{line}</p>
                    ))}
                  </div>
                </div>
              )}

              {step.id === 'workflows' && (
                <div class="output-block output-stack" data-terminal-output>
                  {terminalContent.workflows.map((line) => (
                    <p
                      class:list={{ 'c-muted': 'muted' in line && line.muted }}
                    >
                      <span class="c-green" aria-hidden="true">
                        ■
                      </span>{' '}
                      {'emphasis' in line && (
                        <>
                          <span class="c-white">{line.emphasis}</span>{' '}
                        </>
                      )}
                      {line.text}
                    </p>
                  ))}
                </div>
              )}

              {step.id === 'posts' && (
                <div
                  class="output-block posts-output"
                  lang="en"
                  data-terminal-output
                >
                  <ul class="post-list">
                    {latestPosts.map((post) => (
                      <li class="post-row">
                        <span class="post-meta c-muted">
                          {terminalContent.posts.permissions}
                          {'  '}
                          {username}
                          {'  '}
                          {post.date}
                        </span>
                        <span class="post-details">
                          <a
                            class="term-link"
                            href={`${blogUrl}#${post.anchor}`}
                            data-astro-reload
                          >
                            {post.filename}
                          </a>
                        </span>
                      </li>
                    ))}
                  </ul>
                  <p class="c-muted">{terminalContent.posts.hint}</p>
                  <p>
                    →{' '}
                    <a class="blog-link" href={blogUrl} data-astro-reload>
                      <span class="term-link">Blog</span>{' '}
                      <span class="c-muted">— all posts</span>
                    </a>
                  </p>
                </div>
              )}

              {step.id === 'tools' && (
                <div class="output-block" lang="en" data-terminal-output>
                  {terminalContent.tools.map((tool) => (
                    <div class="tool-row">
                      <a
                        class="tool-link"
                        href={tool.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {tool.name}
                      </a>
                      <span class="c-muted">{tool.description}</span>
                    </div>
                  ))}
                </div>
              )}

              {step.id === 'education' && (
                <div
                  class="output-block output-stack"
                  lang="en"
                  data-terminal-output
                >
                  {terminalContent.education.map((entry) => (
                    <p>
                      <span class="c-yellow">{entry.hash}</span>{' '}
                      <span class="c-muted">{entry.year}</span> {entry.role}{' '}
                      <span class="c-white">{entry.institution}</span>
                    </p>
                  ))}
                </div>
              )}

              {step.id === 'links' && <TerminalContacts />}
            </div>
            {step.id === 'identity' && <PixelAvatar label={labels.avatar} />}
          </div>

          {step.id !== 'links' && (
            <hr
              class="introduction-divider"
              data-terminal-divider
              aria-hidden="true"
            />
          )}
        </div>
      ))}
    </div>

    <div class="prompt-line" data-terminal-prompt aria-hidden="true">
      <TerminalPrompt />
      <div class="typing-line">
        <span class="cmd-text" data-terminal-typing></span>
        <span class="cursor" data-terminal-cursor></span>
      </div>
    </div>
  </div>
</yohoia-terminal>

<script>
  import { registerTerminal } from '@/scripts/terminal';
  registerTerminal();
</script>

<style>
  .index-introduction {
    display: block;
    color: var(--body);
    overflow-anchor: none;
  }
  .introduction-content {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: 1.7;
  }
  .last-login {
    margin-block-end: 1rem;
  }
  .output-block {
    margin-block-end: 0;
  }
  .identity-layout {
    --avatar-max-size: 9rem;
    --avatar-size: var(--avatar-max-size);
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(
        var(--avatar-size),
        var(--avatar-max-size)
      );
    gap: var(--group-gap);
    align-items: start;
  }
  .introduction-divider {
    border: 0;
    border-block-start: 1px solid var(--border);
    margin-block: 0.75rem;
  }
  .introduction-section:last-child {
    margin-block-end: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-terminal-js]) [data-terminal-step]:not([data-visible]),
    :global(html[data-terminal-js])
      [data-terminal-divider]:not([data-visible]) {
      display: none;
    }
    /* 整块输出预留完整高度，头像开始聚合前即可准确测量。 */
    :global(html[data-terminal-js])
      .index-introduction
      :global([data-terminal-output]:not([data-output-visible])) {
      visibility: hidden;
    }
  }
  .prompt-line {
    display: flex;
    margin-block-end: 0.5rem;
  }
  .prompt-line[hidden] {
    display: none;
  }
  .typing-line,
  .cmd-text {
    min-inline-size: 0;
  }
  .cmd-text {
    color: var(--heading);
    font-weight: 600;
  }
  .terminal-name {
    font-size: var(--text-item);
    margin-block-end: 0.5rem;
  }
  .philosophy {
    font-style: italic;
    margin-block-end: 0.5rem;
  }
  .output-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tool-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem;
    margin-block-end: 0.25rem;
  }
  .tool-row:last-child {
    margin-block-end: 0;
  }
  .tool-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    color: var(--signal-text);
    text-decoration: underline dotted;
    text-underline-offset: 0.25em;
  }
  .tool-link:hover,
  .tool-link:focus-visible {
    text-decoration-style: solid;
  }
  .posts-output > p + p {
    margin-block-start: 0.25rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin-block: 0.25rem;
  }
  .post-row {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.75rem;
  }
  .post-row + .post-row {
    margin-block-start: 0.25rem;
  }
  .post-meta {
    white-space: pre;
  }
  .post-details {
    min-inline-size: 0;
  }
  .c-green {
    color: var(--heading);
  }
  .c-yellow {
    color: var(--muted-text);
  }
  .c-orange {
    color: var(--body);
  }
  .c-muted {
    color: var(--muted-text);
  }
  .c-white {
    color: var(--heading);
    font-weight: 600;
  }
  .term-link {
    color: var(--signal-text);
    text-decoration: none;
    border-block-end: 1px dotted currentColor;
    padding-block-end: 1px;
  }
  .blog-link {
    text-decoration: none;
  }
  .cursor {
    display: inline-block;
    inline-size: 0.5rem;
    block-size: 1rem;
    background: var(--terminal-cursor);
    border-radius: 1px;
    box-shadow: 0 0 0.5rem var(--terminal-cursor-glow);
    vertical-align: middle;
  }
  @media (max-width: 35rem) {
    .identity-layout {
      --avatar-size: 8rem;
      position: relative;
      display: block;
    }
    .identity-copy {
      padding-inline-end: calc(var(--avatar-size) + var(--item-gap));
      min-block-size: var(--avatar-size);
    }
    .identity-layout :global([data-terminal-avatar]) {
      position: absolute;
      inset-inline-end: 0;
      inset-block-start: calc(1lh + 0.5rem);
    }
    .post-row {
      grid-template-columns: 1fr;
    }
    .tool-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      margin-block-end: 0.75rem;
    }
    .tool-link {
      min-block-size: var(--touch-target);
    }
  }
  @media (max-width: 24.999rem) {
    .identity-layout {
      --avatar-size: 6.25rem;
    }
  }
</style>
