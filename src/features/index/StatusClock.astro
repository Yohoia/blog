---
import { getLocale } from '@/lib/i18n';
import { ui } from '@/i18n/ui';
const text = ui[getLocale(Astro.url.pathname)];
const now = new Date();
const time = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'UTC',
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
}).format(now);
---

<utc-clock class="status-widget" aria-label={text.utc}>
  <span>{text.earth}</span>
  <time datetime={now.toISOString()}>{time} UTC</time>
</utc-clock>

<script>
  if (!customElements.get('utc-clock')) {
    class UTCClock extends HTMLElement {
      private timer?: number;
      private formatter = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'UTC',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      });

      connectedCallback() {
        this.tick();
      }

      private tick = () => {
        const now = new Date();
        const time = this.querySelector('time');
        if (time) {
          time.dateTime = now.toISOString();
          time.textContent = `${this.formatter.format(now)} UTC`;
        }
        this.timer = window.setTimeout(
          this.tick,
          60_000 - (now.getTime() % 60_000),
        );
      };

      disconnectedCallback() {
        window.clearTimeout(this.timer);
      }
    }
    customElements.define('utc-clock', UTCClock);
  }
</script>

<style>
  .status-widget {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: 1.5;
    color: var(--muted-text);
  }
  time {
    font-variant-numeric: tabular-nums;
  }
  .status-widget > span {
    min-inline-size: 6ch;
  }
</style>
