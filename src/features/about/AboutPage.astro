---
import { ArrowLeft } from '@lucide/astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { iconTokens } from '@/config/icons';
import { sectionPaths } from '@/config/navigation';
import { getLocale, localizePath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';
import { aboutContent } from './config';

const locale = getLocale(Astro.url.pathname);
const text = ui[locale];
const content = aboutContent[locale];
---

<SiteLayout title={text.navigation.about} description={content.introduction}>
  <Container
    as="main"
    id="main-content"
    width="compact"
    class="about-page page-stack"
  >
    <header class="about-introduction" data-language-block="introduction">
      <p class="micro-label">{content.eyebrow}</p>
      <h1 class="text-page font-medium">{content.heading}</h1>
      <p class="text-body">{content.introduction}</p>
    </header>
    <Section
      id="approach"
      title={content.approachTitle}
      data-language-block="approach"
    >
      <p class="text-body">{content.approach}</p>
    </Section>
    <Section
      id="sections"
      title={content.sectionsTitle}
      data-language-block="sections"
    >
      <dl class="about-sections">
        {content.sections.map(({ section, description }, index) => (
          <div class="about-section">
            <dt>
              <span class="micro-label" aria-hidden="true">
                0{index + 1}
              </span>
              <span class="text-item font-medium text-heading">
                {text.navigation[section]}
              </span>
            </dt>
            <dd class="text-meta">{description}</dd>
          </div>
        ))}
      </dl>
    </Section>
    <Section
      id="colophon"
      title={content.colophonTitle}
      data-language-block="colophon"
    >
      <p class="text-body">{content.colophon}</p>
    </Section>
    <footer class="about-footer" data-language-block="footer">
      <TextLink
        href={localizePath(sectionPaths.index, locale)}
        class="about-back"
        data-astro-reload
      >
        <ArrowLeft
          size={iconTokens.size.small}
          stroke-width={iconTokens.strokeWidth}
          aria-hidden="true"
        />
        {content.back}
      </TextLink>
      <span class="micro-label">Yohoia</span>
    </footer>
  </Container>
</SiteLayout>

<style>
  .about-page {
    padding-block: var(--section-gap);
    --about-title-lines: 1;
    --about-introduction-lines: 2;
    --about-paragraph-lines: 3;
  }
  .about-introduction h1 {
    margin-block: var(--item-gap);
    max-inline-size: 22ch;
    min-block-size: calc(var(--about-title-lines) * 1lh);
  }
  .about-introduction > p:last-child {
    min-block-size: calc(var(--about-introduction-lines) * 1lh);
  }
  .about-page :global(#approach .section-content > p),
  .about-page :global(#colophon .section-content > p) {
    min-block-size: calc(var(--about-paragraph-lines) * 1lh);
  }
  .about-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--group-gap);
  }
  .about-section {
    border-block-start: 1px solid var(--border);
    padding-block-start: var(--item-gap);
  }
  .about-section dt {
    display: flex;
    align-items: baseline;
    gap: var(--inline-gap);
  }
  .about-section dd {
    margin-block-start: var(--inline-gap);
    min-block-size: 2lh;
  }
  .about-footer {
    border-block-start: 1px solid var(--border);
    padding-block-start: var(--item-gap);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--item-gap);
  }
  .about-footer :global(.about-back) {
    display: inline-flex;
    align-items: center;
    gap: var(--inline-gap);
    min-block-size: var(--touch-target);
    font-size: var(--text-meta);
  }
  @media (max-width: 35.999rem) {
    .about-page {
      --about-title-lines: 2;
      --about-introduction-lines: 3;
      --about-paragraph-lines: 5;
    }
    .about-sections {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 22.499rem) {
    .about-page {
      --about-introduction-lines: 4;
      --about-paragraph-lines: 6;
    }
  }
</style>
