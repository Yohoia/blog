---
import '@fontsource/space-grotesk/latin-600.css';
import { ArrowUpRight } from '@lucide/astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/components/layout/Container.astro';
import { iconTokens } from '@/config/icons';
import { siteConfig } from '@/config/site';
import { getLocale, localizePath } from '@/lib/i18n';
import { getPublishedEntries, sortByDate } from '@/lib/content/queries';
import { getEntryPath } from '@/lib/content/paths';
import { localeMetadata } from '@/config/i18n';
import { ui } from '@/i18n/ui';
import { blogContent } from './config';
import { getBlogExcerpt } from './reading';

const locale = getLocale(Astro.url.pathname);
const content = blogContent[locale];
const published = await getPublishedEntries('blog');
const entries = sortByDate(
  published.map((entry) => ({
    title: entry.data.title,
    publishedAt: entry.data.publishedAt.toISOString(),
    tags: entry.data.tags,
    href: localizePath(getEntryPath(entry), locale),
    language: entry.data.language,
    excerpt: getBlogExcerpt(entry.body ?? ''),
    anchor: entry.id,
  })),
  (entry) => new Date(entry.publishedAt),
);
const years = new Map<number, Map<number, typeof entries>>();
for (const entry of entries) {
  const date = new Date(entry.publishedAt);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth();
  const months = years.get(year) ?? new Map<number, typeof entries>();
  const posts = months.get(month) ?? [];
  posts.push(entry);
  months.set(month, posts);
  years.set(year, months);
}
const monthFormatter = new Intl.DateTimeFormat(locale, {
  month: 'long',
  timeZone: 'UTC',
});
const weekdayFormatter = new Intl.DateTimeFormat(locale, {
  weekday: 'long',
  timeZone: 'UTC',
});
const yearGroups = [...years].map(([year, months]) => ({
  year,
  count: [...months.values()].reduce((total, posts) => total + posts.length, 0),
  months: [...months].map(([month, posts]) => ({
    name: monthFormatter.format(new Date(Date.UTC(year, month, 1))),
    number: String(month + 1).padStart(2, '0'),
    posts,
  })),
}));
---

<SiteLayout
  title={ui[locale].navigation.blog}
  description={content.introduction}
  hideScrollbar
>
  <Container as="main" id="main-content" width="reading" class="blog-page">
    <header class="blog-introduction" data-language-block="introduction">
      <p class="blog-eyebrow micro-label">
        <span>Blog · {siteConfig.name}</span>
        <span class="blog-rule" aria-hidden="true"></span>
      </p>
      <h1 class="text-display font-medium">{ui[locale].navigation.blog}</h1>
    </header>

    <blog-archive>
      <div class="blog-years">
        {yearGroups.map((group) => (
          <section
            class="blog-entries"
            aria-labelledby={`blog-year-${group.year}`}
          >
            <div class="blog-year-background" aria-hidden="true">
              {group.year}
            </div>
            <h2 id={`blog-year-${group.year}`} class="visually-hidden">
              {group.year}
            </h2>
            <div class="blog-months">
              {group.months.map((month) => (
                <section
                  class="blog-month"
                  aria-label={`${group.year} ${month.name}`}
                >
                  <div class="blog-month-label">
                    <div class="blog-month-sticky micro-label">
                      <span>{month.name}</span>
                    </div>
                  </div>
                  <ol class="blog-posts">
                    {month.posts.map((entry) => (
                      <li
                        id={entry.anchor}
                        data-language-block={`blog-${entry.anchor}`}
                      >
                        <article
                          class="blog-post"
                          aria-labelledby={`${entry.anchor}-title`}
                          data-blog-post
                        >
                          <a
                            class="blog-post-link"
                            href={entry.href}
                            aria-label={entry.title}
                            data-astro-reload
                          >
                            <h3
                              id={`${entry.anchor}-title`}
                              class="blog-post-title text-section font-medium"
                              title={entry.title}
                              lang={localeMetadata[entry.language].language}
                              data-blog-title
                            >
                              <span
                                class="blog-title-highlight"
                                data-blog-highlight
                              >
                                {entry.title}
                              </span>
                            </h3>
                            {entry.excerpt && (
                              <p
                                class="blog-post-excerpt"
                                lang={localeMetadata[entry.language].language}
                                title={entry.excerpt}
                              >
                                {entry.excerpt}
                              </p>
                            )}
                            <span
                              class="blog-post-arrow"
                              data-blog-arrow
                              aria-hidden="true"
                            >
                              <span
                                class="blog-arrow-disc"
                                data-blog-arrow-disc
                              ></span>
                              <span
                                class="blog-arrow-icon"
                                data-blog-arrow-icon
                              >
                                <ArrowUpRight
                                  size={iconTokens.size.normal}
                                  stroke-width={iconTokens.strokeWidth}
                                />
                              </span>
                            </span>
                            <div class="blog-post-meta font-mono text-meta text-muted-text">
                              <time
                                datetime={entry.publishedAt}
                                class="blog-date"
                              >
                                <span class="blog-day">
                                  {new Date(entry.publishedAt).getUTCDate()}
                                </span>
                                <span class="blog-weekday">
                                  {weekdayFormatter.format(
                                    new Date(entry.publishedAt),
                                  )}
                                </span>
                              </time>
                              <div class="blog-post-tags" lang="en">
                                {entry.tags.slice(0, 3).map((tag) => (
                                  <span class="blog-tag" data-blog-tag>
                                    #{tag}
                                    <span
                                      class="blog-tag-underline"
                                      data-blog-tag-underline
                                      aria-hidden="true"
                                    ></span>
                                  </span>
                                ))}
                              </div>
                            </div>
                          </a>
                        </article>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </section>
        ))}
      </div>
    </blog-archive>
  </Container>
</SiteLayout>

<script>
  import { registerBlogArchive } from '@/scripts/blog';
  registerBlogArchive();
</script>

<style>
  .blog-page {
    padding-block: 0 var(--section-gap);
  }
  .blog-introduction {
    padding-block-end: var(--item-gap);
  }
  .blog-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--inline-gap);
    margin-block-end: var(--inline-gap);
  }
  .blog-rule {
    flex: 1;
    block-size: 1px;
    background: var(--border);
  }
  blog-archive {
    display: block;
  }
  .blog-years {
    display: grid;
    gap: var(--group-gap);
  }
  .blog-entries {
    position: relative;
    padding-block-start: var(--group-gap);
  }
  .blog-year-background {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    font-size: clamp(6rem, 15vw, 8rem);
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    text-stroke: 1px var(--border);
    pointer-events: none;
    user-select: none;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-year);
    letter-spacing: -0.02em;
    z-index: 0;
  }
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .blog-months {
    position: relative;
    z-index: 1;
  }
  .blog-month {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    column-gap: var(--item-gap);
  }
  .blog-month-label {
    display: flex;
    align-items: flex-start;
  }
  .blog-month-sticky {
    position: sticky;
    inset-block-start: var(--item-gap);
    display: flex;
    align-items: center;
    min-block-size: calc(
      var(--text-section) * var(--text-section--line-height)
    );
    margin-block-start: calc(var(--item-gap) + 0.125rem);
  }
  .blog-month + .blog-month {
    margin-block-start: var(--group-gap);
  }
  .blog-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
  }
  .blog-post {
    position: relative;
    margin-inline: calc(-1 * var(--inline-gap));
    border-radius: var(--radius-ui);
    background: transparent;
  }
  .blog-post-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    grid-template-rows: auto auto auto;
    align-items: start;
    column-gap: var(--inline-gap);
    padding: var(--item-gap) var(--inline-gap);
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }
  .blog-post-title {
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .blog-post-title {
    grid-column: 1;
    grid-row: 1;
    padding-block-start: 0.125rem;
  }
  .blog-post-excerpt {
    grid-column: 1;
    grid-row: 2;
    max-inline-size: min(42rem, 100%);
    margin: 0.375rem 0 0;
    overflow: hidden;
    color: var(--body);
    font-size: var(--text-meta);
    line-height: 1.6;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .blog-title-highlight {
    --blog-highlight-progress: 0;
    display: block;
    inline-size: max-content;
    max-inline-size: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    background-image: linear-gradient(
      var(--blog-highlight),
      var(--blog-highlight)
    );
    background-repeat: no-repeat;
    background-position: left 75%;
    background-size: calc(var(--blog-highlight-progress) * 100%) 0.72em;
  }
  .blog-post-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .blog-title-highlight {
    color: inherit;
  }
  .blog-post-arrow {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    justify-self: end;
    align-self: center;
    pointer-events: none;
  }
  .blog-arrow-disc {
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
    background: var(--signal-text);
    border-radius: var(--radius-pill);
    opacity: 0;
    transform: scale(0.6);
  }
  .blog-arrow-icon {
    grid-area: 1 / 1;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    color: var(--muted-text);
  }
  blog-archive:not([data-blog-ready]) .blog-post:hover {
    background: var(--hover-surface);
  }
  blog-archive:not([data-blog-ready]) .blog-post:hover .blog-title-highlight {
    --blog-highlight-progress: 1;
  }
  blog-archive:not([data-blog-ready]) .blog-post:hover .blog-arrow-disc {
    opacity: 1;
    transform: none;
  }
  blog-archive:not([data-blog-ready]) .blog-post:hover .blog-arrow-icon {
    color: var(--signal-contrast);
  }
  .blog-post-meta {
    --blog-meta-line-size: calc(
      var(--text-meta) * var(--text-meta--line-height)
    );
    grid-column: 1 / -1;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--inline-gap);
    margin-block-start: var(--inline-gap);
    font-variant-numeric: tabular-nums;
  }
  .blog-date {
    display: inline-flex;
    align-items: center;
    gap: var(--inline-gap);
    white-space: nowrap;
  }
  .blog-day {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--blog-meta-line-size);
    block-size: var(--blog-meta-line-size);
    border-radius: var(--radius-pill);
    background: var(--hover-surface);
    color: var(--muted-text);
    font: inherit;
  }
  .blog-weekday {
    color: var(--muted-text);
  }
  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--inline-gap);
  }
  .blog-tag {
    position: relative;
    display: inline-block;
    color: var(--muted-text);
  }
  .blog-tag-underline {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }
  blog-archive:not([data-blog-ready]) .blog-tag:hover {
    color: var(--heading);
  }
  blog-archive:not([data-blog-ready]) .blog-tag:hover .blog-tag-underline {
    transform: scaleX(1);
  }
  @media (max-width: 40rem) {
    .blog-month {
      grid-template-columns: minmax(0, 1fr);
    }
    .blog-month-label {
      padding-block-start: 0;
      padding-block-end: var(--inline-gap);
    }
    .blog-month-sticky {
      position: static;
      min-block-size: 0;
      margin-block-start: 0;
    }
    .blog-month + .blog-month {
      padding-block-start: var(--item-gap);
    }
  }
</style>
