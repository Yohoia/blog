---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { CalendarDays, Clock3, CornerUpLeft, Tags, Type } from '@lucide/astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Prose from '@/components/content/Prose.astro';
import { localeMetadata } from '@/config/i18n';
import { iconTokens } from '@/config/icons';
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import YohoiaAvatar from '@/assets/images/yohoia-avatar.jpg';
import { getLocale, localizePath } from '@/lib/i18n';
import ArticleToc from './ArticleToc.astro';
import ArticleRail from './ArticleRail.astro';
import { getReadingStats } from './reading';
import '@fontsource-variable/newsreader/wght.css';
import 'katex/dist/katex.min.css';
import './article.css';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const { Content, headings } = await render(entry);
const stats = getReadingStats(entry.body ?? '');
const formatShortDate = (date: Date) =>
  `${date.getUTCFullYear()}/${String(date.getUTCMonth() + 1).padStart(2, '0')}/${String(date.getUTCDate()).padStart(2, '0')}`;
const text =
  locale === 'zh'
    ? {
        back: '返回 Blog',
        words: '字',
        minutes: '分钟',
        updated: '更新于',
      }
    : {
        back: 'Back to Blog',
        words: 'words',
        minutes: 'min',
        updated: 'Updated',
      };
const readingTime =
  locale === 'zh'
    ? `${stats.minutes}${text.minutes}`
    : `${stats.minutes} ${text.minutes}`;
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  alternateLocales={false}
  hideScrollbar
>
  <main id="main-content" class="article-page">
    <article class="article-main" data-article-content>
      <nav class="article-return" aria-label={text.back}>
        <a
          href={localizePath(sectionPaths.blog, locale)}
          class="article-back"
          aria-label={text.back}
          title={text.back}
          data-astro-reload
        >
          <span class="article-back-icon" aria-hidden="true">
            <CornerUpLeft
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
            />
          </span>
          <code lang="en">cd ../</code>
        </a>
      </nav>

      <header class="article-header" data-language-block="article-header">
        <h1
          class="article-title"
          lang={localeMetadata[entry.data.language].language}
        >
          {entry.data.title}
        </h1>
        <div
          class="article-meta"
          aria-label={locale === 'zh' ? '文章信息' : 'Article information'}
        >
          <span class="article-meta-item article-author">
            <Image
              class="article-author-avatar"
              src={YohoiaAvatar}
              alt=""
              widths={[40, 64]}
              sizes="20px"
            />
            <span>{siteConfig.name}</span>
          </span>
          <time
            class="article-meta-item"
            datetime={entry.data.publishedAt.toISOString()}
          >
            <CalendarDays
              class="article-meta-icon"
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
            <span>{formatShortDate(entry.data.publishedAt)}</span>
          </time>
          {entry.data.tags.length > 0 && (
            <span class="article-meta-item article-tags">
              <Tags
                class="article-meta-icon"
                size={iconTokens.size.small}
                stroke-width={iconTokens.strokeWidth}
                aria-hidden="true"
              />
              {entry.data.tags.map((tag) => (
                <span class="article-tag">{tag}</span>
              ))}
            </span>
          )}
          <span class="article-meta-item">
            <Type
              class="article-meta-icon"
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
            <span>
              {stats.units.toLocaleString(localeMetadata[locale].dateLocale)}{' '}
              {text.words}
            </span>
          </span>
          <span class="article-meta-item">
            <Clock3
              class="article-meta-icon"
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
            <span>{readingTime}</span>
          </span>
        </div>
        {entry.data.updatedAt && (
          <p class="article-updated font-mono text-meta text-muted-text">
            {text.updated}{' '}
            <time datetime={entry.data.updatedAt.toISOString()}>
              {formatShortDate(entry.data.updatedAt)}
            </time>
          </p>
        )}
      </header>

      {entry.data.cover && (
        <figure class="article-cover">
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            widths={[640, 920, 1380, 1840]}
            sizes="min(920px, calc(100vw - 3.75rem))"
          />
          {entry.data.coverAlt && (
            <figcaption>{entry.data.coverAlt}</figcaption>
          )}
        </figure>
      )}

      <Prose
        class="article-prose"
        editorial="serif"
        lang={localeMetadata[entry.data.language].language}
        data-language-block="article-body"
      >
        <Content />
      </Prose>
    </article>

    <div class="article-side">
      <ArticleToc headings={headings} locale={locale} />
      <ArticleRail locale={locale} title={entry.data.title} />
    </div>
  </main>
</SiteLayout>
