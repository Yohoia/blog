---
import { ChevronLeft } from '@lucide/astro';
import { iconTokens } from '@/config/icons';
import type { Locale } from '@/config/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4,
);
const label = locale === 'zh' ? '文章目录' : 'Table of contents';
---

{items.length > 0 && (
  <aside class="article-aside">
    <article-toc>
      <button
        class="toc-edge-trigger"
        type="button"
        aria-label={locale === 'zh' ? '显示文章目录' : 'Show table of contents'}
        title={label}
        aria-expanded="false"
        aria-controls="article-toc-panel"
        data-toc-trigger
        data-open-label={
          locale === 'zh' ? '收起文章目录' : 'Hide table of contents'
        }
        data-closed-label={
          locale === 'zh' ? '显示文章目录' : 'Show table of contents'
        }
      >
        <ChevronLeft stroke-width={iconTokens.strokeWidth} aria-hidden="true" />
      </button>
      <h2 class="toc-title">On this page</h2>
      <div class="toc-panel" id="article-toc-panel" data-toc-panel>
        <nav class="toc-nav" aria-label={label} data-toc-nav>
          <div class="toc-scroll" data-toc-scroll>
            <ol class="toc-list">
              {items.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link"
                    data-toc-link
                    data-depth={heading.depth}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      </div>
    </article-toc>
  </aside>
)}

<script>
  import { registerArticleToc } from '@/scripts/article-toc';
  registerArticleToc();
</script>

<style>
  .article-aside {
    position: static;
    z-index: 30;
    inline-size: 100%;
    margin: 0;
  }
  article-toc {
    position: relative;
    display: block;
    font-family: var(--font-sans);
  }
  .toc-edge-trigger {
    display: none;
  }
  .toc-title {
    display: flex;
    align-items: flex-start;
    block-size: var(--touch-target);
    margin: 0;
    padding: 0;
    color: var(--heading);
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.5;
  }
  .toc-title::before {
    display: block;
    inline-size: 2px;
    block-size: 0.875rem;
    margin-inline-end: 0.625rem;
    background: var(--signal-text);
    content: '';
  }
  .toc-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    inline-size: 10.3125rem;
    margin-inline-start: 2.1875rem;
    block-size: auto;
    padding-block-start: 0;
  }
  .toc-nav {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: hidden;
  }
  .toc-scroll {
    block-size: auto;
    max-block-size: 15.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .toc-scroll::-webkit-scrollbar {
    display: none;
  }
  .toc-nav::before,
  .toc-nav::after {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    block-size: 4rem;
    opacity: 0;
    pointer-events: none;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    content: '';
  }
  .toc-nav::before {
    inset-block-start: 0;
    background: linear-gradient(to bottom, var(--canvas), transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000 35%, transparent);
  }
  .toc-nav::after {
    inset-block-end: 0;
    background: linear-gradient(to top, var(--canvas), transparent);
    -webkit-mask-image: linear-gradient(to top, #000 35%, transparent);
    mask-image: linear-gradient(to top, #000 35%, transparent);
  }
  .toc-nav[data-can-scroll-up]::before,
  .toc-nav[data-can-scroll-down]::after {
    opacity: 1;
  }
  .toc-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc-link {
    display: block;
    inline-size: fit-content;
    max-inline-size: 9rem;
    padding: 0.3rem 0.125rem 0.3rem 0.875rem;
    line-height: 1.5;
    color: var(--muted-text);
    font-size: var(--text-meta);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }
  .toc-link[data-depth='3'] {
    margin-inline-start: 1rem;
    max-inline-size: calc(100% - 1rem);
  }
  .toc-link[data-depth='4'] {
    margin-inline-start: 2rem;
    max-inline-size: calc(100% - 2rem);
  }
  .toc-link:hover,
  .toc-link[aria-current='location'] {
    color: var(--signal-text);
    text-decoration-color: currentColor;
  }
  @media (min-width: 64rem) {
    .toc-list {
      gap: 0.0625rem;
    }
    .toc-link {
      padding-block: 0.125rem;
      line-height: 1.3125rem;
    }
  }
  @media (max-width: 63.999rem) {
    article-toc {
      --toc-drawer-width: min(18rem, calc(100vw - 3.25rem));
    }
    .toc-title {
      display: none;
    }
    .toc-scroll {
      max-block-size: none;
    }
    .article-aside {
      position: fixed;
      inset-block-start: 0;
      inset-inline-start: 0;
      grid-column: auto;
      grid-row: auto;
      inline-size: 0;
      block-size: 0;
      margin: 0;
    }
    .toc-edge-trigger {
      position: fixed;
      z-index: 2;
      inset-block-start: 50dvh;
      inset-inline-end: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      inline-size: var(--touch-target);
      block-size: var(--touch-target);
      padding: 0 0.375rem 0 0;
      transform: translateY(-50%);
      border: 0;
      background: transparent;
      color: var(--muted-text);
      cursor: pointer;
    }
    .toc-edge-trigger::before {
      position: absolute;
      z-index: -1;
      inset-block: 0;
      inset-inline-end: 0;
      inline-size: 1.75rem;
      border: 1px solid var(--border);
      border-inline-end: 0;
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
      background: var(--surface);
      box-shadow: var(--floating-shadow);
      content: '';
    }
    .toc-edge-trigger:hover,
    .toc-edge-trigger:focus-visible {
      color: var(--heading);
    }
    .toc-edge-trigger :global(svg) {
      inline-size: 1.125rem;
      block-size: 1.125rem;
    }
    article-toc[data-open] .toc-edge-trigger {
      inset-inline-end: var(--toc-drawer-width);
    }
    article-toc[data-open] .toc-edge-trigger :global(svg) {
      transform: rotate(180deg);
    }
    .toc-panel {
      position: fixed;
      inset-block-start: var(--toc-mobile-top, 5rem);
      inset-inline-start: auto;
      inset-inline-end: 0;
      inset-block-end: auto;
      inline-size: var(--toc-drawer-width);
      block-size: auto;
      max-block-size: calc(
        100dvh - var(--toc-mobile-top, 5rem) - var(--gutter)
      );
      margin: 0;
      padding: var(--item-gap);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      box-shadow: var(--floating-shadow);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .toc-panel::-webkit-scrollbar {
      display: none;
    }
    .toc-nav {
      flex: 0 1 24rem;
      min-block-size: 6rem;
    }
    article-toc[data-ready] .toc-panel {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
