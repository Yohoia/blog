---
import {
  ArrowUpRight,
  ChevronDown,
  ChevronLeft,
  Copy,
  MessageCircle,
  Star,
} from '@lucide/astro';
import { iconTokens } from '@/config/icons';
import type { Locale } from '@/config/i18n';
import { siteConfig } from '@/config/site';
import GitHub from '@/assets/icons/social/github.svg';
import OpenAI from '@/assets/icons/social/openai.svg';
import Claude from '@/assets/icons/social/claude.svg';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  locale: Locale;
  editUrl?: string;
}

const { headings, locale, editUrl } = Astro.props;
const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4,
);
const label = locale === 'zh' ? '文章目录' : 'Table of contents';
const text =
  locale === 'zh'
    ? {
        edit: '在 GitHub 编辑此页',
        star: '在 GitHub 加星',
        copy: '复制本页',
        copied: '已复制',
        copyFailed: '复制失败',
        chat: '在聊天中打开',
        copyForChat: '复制文章内容',
        chatGpt: '复制文章并打开 ChatGPT',
        claude: '复制文章并打开 Claude',
        copiedStatus: '文章内容已复制',
        chatStatus: '文章内容已复制，请粘贴到聊天窗口',
        failedStatus: '无法复制文章内容',
      }
    : {
        edit: 'Edit this page on GitHub',
        star: 'Star on GitHub',
        copy: 'Copy page',
        copied: 'Copied',
        copyFailed: 'Copy failed',
        chat: 'Open in Chat',
        copyForChat: 'Copy article text',
        chatGpt: 'Copy article and open ChatGPT',
        claude: 'Copy article and open Claude',
        copiedStatus: 'Article copied',
        chatStatus: 'Article copied. Paste it into the chat.',
        failedStatus: 'Unable to copy article',
      };
---

{items.length > 0 && (
  <aside class="article-aside">
    <article-toc>
      <button
        class="toc-edge-trigger"
        type="button"
        aria-label={locale === 'zh' ? '显示文章目录' : 'Show table of contents'}
        title={label}
        aria-expanded="false"
        aria-controls="article-toc-panel"
        data-toc-trigger
        data-open-label={
          locale === 'zh' ? '收起文章目录' : 'Hide table of contents'
        }
        data-closed-label={
          locale === 'zh' ? '显示文章目录' : 'Show table of contents'
        }
      >
        <ChevronLeft stroke-width={iconTokens.strokeWidth} aria-hidden="true" />
      </button>
      <h2 class="toc-title">On this page</h2>
      <div class="toc-panel" id="article-toc-panel" data-toc-panel>
        <nav class="toc-nav" aria-label={label} data-toc-nav>
          <div class="toc-scroll" data-toc-scroll>
            <ol class="toc-list">
              {items.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link"
                    data-toc-link
                    data-depth={heading.depth}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
        <div class="toc-actions">
          {editUrl && (
            <a
              class="toc-action"
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <GitHub
                class="toc-action-icon"
                fill="currentColor"
                aria-hidden="true"
              />
              <span class="toc-action-label">{text.edit}</span>
              <ArrowUpRight class="toc-action-tail" aria-hidden="true" />
            </a>
          )}
          <a
            class="toc-action"
            href={siteConfig.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Star
              class="toc-action-icon"
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
            <span class="toc-action-label">{text.star}</span>
            <ArrowUpRight class="toc-action-tail" aria-hidden="true" />
          </a>
          <button
            class="toc-action toc-copy"
            type="button"
            data-toc-copy
            data-copy-label={text.copy}
            data-copied-label={text.copied}
            data-failed-label={text.copyFailed}
            data-copied-status={text.copiedStatus}
            data-chat-status={text.chatStatus}
            data-failed-status={text.failedStatus}
          >
            <Copy
              class="toc-action-icon"
              stroke-width={iconTokens.strokeWidth}
              aria-hidden="true"
            />
            <span class="toc-action-label" data-toc-copy-label>
              {text.copy}
            </span>
          </button>
          <div class="toc-chat">
            <button
              class="toc-action"
              type="button"
              aria-expanded="false"
              aria-controls="article-toc-chat-menu"
              data-toc-chat-trigger
            >
              <MessageCircle
                class="toc-action-icon"
                stroke-width={iconTokens.strokeWidth}
                aria-hidden="true"
              />
              <span class="toc-action-label">{text.chat}</span>
              <ChevronDown
                class="toc-action-tail toc-chat-chevron"
                aria-hidden="true"
              />
            </button>
            <div
              class="toc-chat-menu"
              id="article-toc-chat-menu"
              popover="auto"
              data-toc-chat-menu
            >
              <button class="toc-chat-option" type="button" data-toc-chat-copy>
                <Copy aria-hidden="true" />
                <span>{text.copyForChat}</span>
              </button>
              <div class="toc-chat-divider" aria-hidden="true"></div>
              <a
                class="toc-chat-option"
                href="https://chatgpt.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={text.chatGpt}
                data-toc-chat-link
              >
                <OpenAI aria-hidden="true" />
                <span>ChatGPT</span>
                <ArrowUpRight class="toc-chat-arrow" aria-hidden="true" />
              </a>
              <a
                class="toc-chat-option"
                href="https://claude.ai/new"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={text.claude}
                data-toc-chat-link
              >
                <Claude aria-hidden="true" />
                <span>Claude</span>
                <ArrowUpRight class="toc-chat-arrow" aria-hidden="true" />
              </a>
            </div>
          </div>
          <p class="sr-only" role="status" data-toc-status></p>
        </div>
      </div>
    </article-toc>
  </aside>
)}

<script>
  import { registerArticleToc } from '@/scripts/article-toc';
  registerArticleToc();
</script>

<style>
  .article-aside {
    position: sticky;
    z-index: 30;
    inset-block-start: 0;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    inline-size: 15rem;
    block-size: var(--touch-target);
    margin-inline-start: calc(clamp(1rem, 3vw, 3rem) - var(--gutter));
  }
  article-toc {
    position: relative;
    display: block;
    font-family: var(--font-sans);
  }
  .toc-edge-trigger {
    display: none;
  }
  .toc-title {
    display: flex;
    align-items: center;
    block-size: var(--touch-target);
    margin: 0;
    padding: 0;
    color: var(--heading);
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.5;
  }
  .toc-title::before {
    display: block;
    inline-size: 2px;
    block-size: 0.875rem;
    margin-inline-end: 0.625rem;
    background: var(--signal-text);
    content: '';
  }
  .toc-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    block-size: var(
      --toc-panel-height,
      calc(100dvh - var(--touch-target) - var(--gutter) - 6.5rem)
    );
    padding-block-start: 0.5rem;
  }
  .toc-nav {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: hidden;
  }
  .toc-scroll {
    block-size: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .toc-scroll::-webkit-scrollbar {
    display: none;
  }
  .toc-nav::before,
  .toc-nav::after {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    block-size: 4rem;
    opacity: 0;
    pointer-events: none;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    content: '';
  }
  .toc-nav::before {
    inset-block-start: 0;
    background: linear-gradient(to bottom, var(--canvas), transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000 35%, transparent);
  }
  .toc-nav::after {
    inset-block-end: 0;
    background: linear-gradient(to top, var(--canvas), transparent);
    -webkit-mask-image: linear-gradient(to top, #000 35%, transparent);
    mask-image: linear-gradient(to top, #000 35%, transparent);
  }
  .toc-nav[data-can-scroll-up]::before,
  .toc-nav[data-can-scroll-down]::after {
    opacity: 1;
  }
  .toc-list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc-link {
    display: block;
    inline-size: fit-content;
    max-inline-size: 100%;
    padding: 0.3rem 0.125rem;
    color: var(--muted-text);
    font-size: var(--text-meta);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }
  .toc-link[data-depth='3'] {
    margin-inline-start: 1rem;
    max-inline-size: calc(100% - 1rem);
  }
  .toc-link[data-depth='4'] {
    margin-inline-start: 2rem;
    max-inline-size: calc(100% - 2rem);
  }
  .toc-link:hover,
  .toc-link[aria-current='location'] {
    color: var(--signal-text);
    text-decoration-color: currentColor;
  }
  .toc-actions {
    flex: none;
    margin-block-start: var(--inline-gap);
    padding-block-start: 0.375rem;
    border-block-start: 1px solid var(--border);
  }
  .toc-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    inline-size: 100%;
    min-block-size: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted-text);
    font: inherit;
    font-size: var(--text-meta);
    line-height: 1.5;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .toc-action:hover,
  .toc-action:focus-visible,
  .toc-chat-option:hover,
  .toc-chat-option:focus-visible {
    color: var(--heading);
  }
  .toc-action-icon {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }
  .toc-action-label {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toc-action-tail {
    flex: none;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    margin-inline-start: auto;
  }
  .toc-chat [aria-expanded='true'] .toc-chat-chevron {
    transform: rotate(180deg);
  }
  .toc-chat-menu {
    position: fixed;
    inset: auto;
    inline-size: min(15rem, calc(100vw - var(--gutter) * 2));
    max-block-size: calc(100dvh - var(--gutter) * 2);
    margin: 0;
    padding: 0.375rem;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--floating-shadow);
    color: var(--muted-text);
    font-family: var(--font-sans);
    scrollbar-width: none;
  }
  .toc-chat-menu::-webkit-scrollbar {
    display: none;
  }
  .toc-chat-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    inline-size: 100%;
    min-block-size: var(--touch-target);
    padding-inline: 0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-text);
    font: inherit;
    font-size: var(--text-meta);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .toc-chat-option:hover,
  .toc-chat-option:focus-visible {
    background: var(--canvas);
    color: var(--heading);
  }
  .toc-chat-option > :global(svg) {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }
  .toc-chat-option .toc-chat-arrow {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    margin-inline-start: auto;
  }
  .toc-chat-divider {
    margin-block: 0.375rem;
    border-block-start: 1px solid var(--border);
  }
  article-toc:not([data-ready]) .toc-copy,
  article-toc:not([data-ready]) .toc-chat {
    display: none;
  }
  @media (max-width: 83.999rem) {
    article-toc {
      --toc-drawer-width: min(18rem, calc(100vw - 3.25rem));
    }
    .article-aside {
      position: fixed;
      inset-block-start: 0;
      inset-inline-start: 0;
      grid-column: auto;
      grid-row: auto;
      inline-size: 0;
      block-size: 0;
      margin: 0;
    }
    .toc-edge-trigger {
      position: fixed;
      z-index: 2;
      inset-block-start: 50dvh;
      inset-inline-end: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      inline-size: var(--touch-target);
      block-size: var(--touch-target);
      padding: 0 0.375rem 0 0;
      transform: translateY(-50%);
      border: 0;
      background: transparent;
      color: var(--muted-text);
      cursor: pointer;
    }
    .toc-edge-trigger::before {
      position: absolute;
      z-index: -1;
      inset-block: 0;
      inset-inline-end: 0;
      inline-size: 1.75rem;
      border: 1px solid var(--border);
      border-inline-end: 0;
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
      background: var(--surface);
      box-shadow: var(--floating-shadow);
      content: '';
    }
    .toc-edge-trigger:hover,
    .toc-edge-trigger:focus-visible {
      color: var(--heading);
    }
    .toc-edge-trigger :global(svg) {
      inline-size: 1.125rem;
      block-size: 1.125rem;
    }
    article-toc[data-open] .toc-edge-trigger {
      inset-inline-end: var(--toc-drawer-width);
    }
    article-toc[data-open] .toc-edge-trigger :global(svg) {
      transform: rotate(180deg);
    }
    .toc-title {
      display: none;
    }
    .toc-panel {
      position: fixed;
      inset-block-start: var(--toc-mobile-top, 5rem);
      inset-inline-start: auto;
      inset-inline-end: 0;
      inset-block-end: auto;
      inline-size: var(--toc-drawer-width);
      block-size: auto;
      max-block-size: calc(
        100dvh - var(--toc-mobile-top, 5rem) - var(--gutter)
      );
      margin: 0;
      padding: var(--item-gap);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      box-shadow: var(--floating-shadow);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .toc-panel::-webkit-scrollbar {
      display: none;
    }
    .toc-nav {
      flex: 0 1 24rem;
      min-block-size: 6rem;
    }
    article-toc[data-ready] .toc-panel {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .toc-action {
      min-block-size: var(--touch-target);
    }
    .toc-nav::before {
      background: linear-gradient(to bottom, var(--surface), transparent);
    }
    .toc-nav::after {
      background: linear-gradient(to top, var(--surface), transparent);
    }
  }
</style>
