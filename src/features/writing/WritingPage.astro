---
import '@fontsource/space-grotesk/latin-600.css';
import { ArrowUpRight, CornerUpLeft } from '@lucide/astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Container from '@/components/layout/Container.astro';
import { iconTokens } from '@/config/icons';
import { siteConfig } from '@/config/site';
import { sectionPaths } from '@/config/navigation';
import { getLocale, localizePath } from '@/lib/i18n';
import { sortByDate } from '@/lib/content/queries';
import { ui } from '@/i18n/ui';
import { referenceWritingEntries, writingContent } from './config';

const locale = getLocale(Astro.url.pathname);
const content = writingContent[locale];
const entries = sortByDate(
  [...referenceWritingEntries].reverse(),
  (entry) => new Date(entry.publishedAt),
);
const years = new Map<number, Map<number, typeof entries>>();
for (const entry of entries) {
  const date = new Date(entry.publishedAt);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth();
  const months = years.get(year) ?? new Map<number, typeof entries>();
  const posts = months.get(month) ?? [];
  posts.push(entry);
  months.set(month, posts);
  years.set(year, months);
}
const monthFormatter = new Intl.DateTimeFormat(locale, {
  month: 'long',
  timeZone: 'UTC',
});
const weekdayFormatter = new Intl.DateTimeFormat(locale, {
  weekday: 'long',
  timeZone: 'UTC',
});
const yearGroups = [...years].map(([year, months]) => ({
  year,
  count: [...months.values()].reduce((total, posts) => total + posts.length, 0),
  months: [...months].map(([month, posts]) => ({
    name: monthFormatter.format(new Date(Date.UTC(year, month, 1))),
    number: String(month + 1).padStart(2, '0'),
    posts,
  })),
}));
---

<SiteLayout
  title={ui[locale].navigation.writing}
  description={content.introduction}
  hideScrollbar
>
  <Container as="main" id="main-content" width="reading" class="writing-page">
    <header class="writing-introduction" data-language-block="introduction">
      <p class="writing-eyebrow micro-label">
        <span>Writing · {siteConfig.name}</span>
        <span class="writing-rule" aria-hidden="true"></span>
      </p>
      <h1 class="text-display font-medium">{ui[locale].navigation.writing}</h1>
    </header>

    <writing-archive>
      <div class="writing-years">
        {yearGroups.map((group) => (
          <section
            class="writing-entries"
            aria-labelledby={`writing-year-${group.year}`}
          >
            <div class="writing-year-background" aria-hidden="true">
              {group.year}
            </div>
            <h2 id={`writing-year-${group.year}`} class="visually-hidden">
              {group.year}
            </h2>
            <div class="writing-months">
              {group.months.map((month) => (
                <section
                  class="writing-month"
                  aria-label={`${group.year} ${month.name}`}
                >
                  <div class="writing-month-label">
                    <div class="writing-month-sticky micro-label">
                      <span>{month.name}</span>
                    </div>
                  </div>
                  <ol class="writing-posts">
                    {month.posts.map((entry) => (
                      <li
                        id={entry.filename}
                        data-language-block={`writing-${entry.filename}`}
                      >
                        <article
                          class="writing-post"
                          aria-labelledby={`${entry.filename}-title`}
                          data-writing-post
                        >
                          <h3
                            id={`${entry.filename}-title`}
                            class="writing-post-title text-section font-medium"
                            lang="en"
                            title={entry.title}
                            data-writing-title
                          >
                            <span
                              class="writing-title-highlight"
                              data-writing-highlight
                            >
                              {entry.title}
                            </span>
                          </h3>
                          <p
                            class="writing-post-filename text-meta font-mono"
                            lang="en"
                            title={entry.filename}
                          >
                            {entry.filename}
                          </p>
                          <span
                            class="writing-post-arrow"
                            data-writing-arrow
                            aria-hidden="true"
                          >
                            <span
                              class="writing-arrow-disc"
                              data-writing-arrow-disc
                            ></span>
                            <span
                              class="writing-arrow-icon"
                              data-writing-arrow-icon
                            >
                              <ArrowUpRight
                                size={iconTokens.size.normal}
                                stroke-width={iconTokens.strokeWidth}
                              />
                            </span>
                          </span>
                          <div class="writing-post-meta font-mono text-meta text-muted-text">
                            <time
                              datetime={entry.publishedAt}
                              class="writing-date"
                            >
                              <span class="writing-day">
                                {new Date(entry.publishedAt).getUTCDate()}
                              </span>
                              <span class="writing-weekday">
                                {weekdayFormatter.format(
                                  new Date(entry.publishedAt),
                                )}
                              </span>
                            </time>
                            <div class="writing-post-tags" lang="en">
                              {entry.tags.slice(0, 3).map((tag) => (
                                <span class="writing-tag" data-writing-tag>
                                  #{tag}
                                  <span
                                    class="writing-tag-underline"
                                    data-writing-tag-underline
                                    aria-hidden="true"
                                  ></span>
                                </span>
                              ))}
                            </div>
                          </div>
                        </article>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </section>
        ))}
      </div>

      <footer class="writing-footer" data-language-block="footer">
        <a
          href={localizePath(sectionPaths.index, locale)}
          class="writing-back font-mono text-meta"
          aria-label={content.back}
          title={content.back}
          data-writing-back
          data-astro-reload
        >
          <span
            class="writing-back-icon"
            data-writing-back-icon
            aria-hidden="true"
          >
            <CornerUpLeft
              size={iconTokens.size.small}
              stroke-width={iconTokens.strokeWidth}
            />
          </span>
          <code lang="en">cd ../</code>
        </a>
      </footer>
    </writing-archive>
  </Container>
</SiteLayout>

<script>
  import { registerWritingArchive } from '@/scripts/writing';
  registerWritingArchive();
</script>

<style>
  .writing-page {
    padding-block: 0 var(--section-gap);
  }
  .writing-introduction {
    padding-block-end: var(--item-gap);
  }
  .writing-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--inline-gap);
    margin-block-end: var(--inline-gap);
  }
  .writing-rule {
    flex: 1;
    block-size: 1px;
    background: var(--border);
  }
  writing-archive {
    display: block;
  }
  .writing-years {
    display: grid;
    gap: var(--group-gap);
  }
  .writing-entries {
    position: relative;
    padding-block-start: var(--group-gap);
  }
  .writing-year-background {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    font-size: clamp(6rem, 15vw, 8rem);
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    text-stroke: 1px var(--border);
    pointer-events: none;
    user-select: none;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-year);
    letter-spacing: -0.02em;
    z-index: 0;
  }
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .writing-months {
    position: relative;
    z-index: 1;
  }
  .writing-month {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    column-gap: var(--item-gap);
  }
  .writing-month-label {
    display: flex;
    align-items: flex-start;
  }
  .writing-month-sticky {
    position: sticky;
    inset-block-start: calc(var(--touch-target) * 2 + var(--item-gap));
    display: flex;
    align-items: center;
    min-block-size: calc(
      var(--text-section) * var(--text-section--line-height)
    );
    margin-block-start: calc(var(--item-gap) + 0.125rem);
  }
  .writing-month + .writing-month {
    margin-block-start: var(--group-gap);
  }
  .writing-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
  }
  .writing-post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    grid-template-rows: auto auto auto;
    align-items: start;
    column-gap: var(--inline-gap);
    margin-inline: calc(-1 * var(--inline-gap));
    padding: var(--item-gap) var(--inline-gap);
    border-radius: var(--radius-ui);
    background: transparent;
  }
  .writing-post-title,
  .writing-post-filename {
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .writing-post-title {
    grid-column: 1;
    grid-row: 1;
    padding-block-start: 0.125rem;
  }
  .writing-title-highlight {
    --writing-highlight-progress: 0;
    display: block;
    inline-size: max-content;
    max-inline-size: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    background-image: linear-gradient(
      var(--writing-highlight),
      var(--writing-highlight)
    );
    background-repeat: no-repeat;
    background-position: left 75%;
    background-size: calc(var(--writing-highlight-progress) * 100%) 0.72em;
  }
  .writing-post-filename {
    grid-column: 1;
    grid-row: 2;
    margin-block-start: var(--inline-gap);
    color: var(--body);
  }
  .writing-post-arrow {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    justify-self: end;
    align-self: center;
    pointer-events: none;
  }
  .writing-arrow-disc {
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
    background: var(--signal-text);
    border-radius: var(--radius-pill);
    opacity: 0;
    transform: scale(0.6);
  }
  .writing-arrow-icon {
    grid-area: 1 / 1;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    color: var(--muted-text);
  }
  writing-archive:not([data-writing-ready]) .writing-post:hover {
    background: var(--hover-surface);
  }
  writing-archive:not([data-writing-ready])
    .writing-post:hover
    .writing-title-highlight {
    --writing-highlight-progress: 1;
  }
  writing-archive:not([data-writing-ready])
    .writing-post:hover
    .writing-arrow-disc {
    opacity: 1;
    transform: none;
  }
  writing-archive:not([data-writing-ready])
    .writing-post:hover
    .writing-arrow-icon {
    color: var(--signal-contrast);
  }
  .writing-post-meta {
    --writing-meta-line-size: calc(
      var(--text-meta) * var(--text-meta--line-height)
    );
    grid-column: 1 / -1;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--inline-gap);
    margin-block-start: var(--inline-gap);
    font-variant-numeric: tabular-nums;
  }
  .writing-date {
    display: inline-flex;
    align-items: center;
    gap: var(--inline-gap);
    white-space: nowrap;
  }
  .writing-day {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--writing-meta-line-size);
    block-size: var(--writing-meta-line-size);
    border-radius: var(--radius-pill);
    background: var(--hover-surface);
    color: var(--muted-text);
    font: inherit;
  }
  .writing-weekday {
    color: var(--muted-text);
  }
  .writing-post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--inline-gap);
  }
  .writing-tag {
    position: relative;
    display: inline-block;
    color: var(--muted-text);
  }
  .writing-tag-underline {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }
  writing-archive:not([data-writing-ready]) .writing-tag:hover {
    color: var(--heading);
  }
  writing-archive:not([data-writing-ready])
    .writing-tag:hover
    .writing-tag-underline {
    transform: scaleX(1);
  }
  .writing-footer {
    margin-block-start: var(--section-gap);
    padding-block-start: var(--item-gap);
    border-block-start: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--item-gap);
    flex-wrap: wrap;
  }
  .writing-footer > p {
    flex: 1 1 16rem;
  }
  .writing-back {
    display: inline-flex;
    align-items: center;
    gap: var(--inline-gap);
    min-block-size: var(--touch-target);
    color: var(--muted-text);
    text-decoration: none;
    transition: color var(--duration-ui) var(--easing);
  }
  .writing-back-icon {
    display: inline-flex;
    color: inherit;
  }
  .writing-back:hover,
  .writing-back:focus-visible {
    color: var(--signal-text);
  }
  .writing-back:hover code,
  .writing-back:focus-visible code {
    color: var(--signal-text);
  }
  @media (max-width: 40rem) {
    .writing-month {
      grid-template-columns: minmax(0, 1fr);
    }
    .writing-month-label {
      padding-block-start: 0;
      padding-block-end: var(--inline-gap);
    }
    .writing-month-sticky {
      position: static;
      min-block-size: 0;
      margin-block-start: 0;
    }
    .writing-month + .writing-month {
      padding-block-start: var(--item-gap);
    }
  }
</style>
