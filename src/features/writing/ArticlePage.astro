---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { relative, resolve, sep } from 'node:path';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Prose from '@/components/content/Prose.astro';
import { localeMetadata } from '@/config/i18n';
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import { getLocale, localizePath } from '@/lib/i18n';
import ArticleToc from './ArticleToc.astro';
import { getReadingStats } from './reading';
import '@fontsource-variable/newsreader/wght.css';
import './article.css';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const { Content, headings } = await render(entry);
const sourcePath = entry.filePath
  ? relative(process.cwd(), resolve(entry.filePath))
  : undefined;
const editUrl = sourcePath?.startsWith(`src${sep}content${sep}writing${sep}`)
  ? `${siteConfig.repositoryUrl}/edit/main/${sourcePath
      .split(sep)
      .map(encodeURIComponent)
      .join('/')}`
  : undefined;
const stats = getReadingStats(entry.body ?? '');
const dateFormatter = new Intl.DateTimeFormat(
  localeMetadata[locale].dateLocale,
  {
    year: 'numeric',
    month: locale === 'zh' ? 'long' : 'short',
    day: 'numeric',
    timeZone: 'UTC',
  },
);
const text =
  locale === 'zh'
    ? {
        back: '返回写作',
        words: '字词',
        minutes: '分钟阅读',
        updated: '更新于',
        author: '原文署名：',
        example: '案例文档',
      }
    : {
        back: 'Back to Writing',
        words: 'words / characters',
        minutes: 'min read',
        updated: 'Updated',
        author: 'Original author: ',
        example: 'Example article',
      };
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  alternateLocales={false}
>
  <main id="main-content" class="article-page">
    <ArticleToc headings={headings} locale={locale} editUrl={editUrl} />
    <article class="article-main" data-article-content>
      <header class="article-header" data-language-block="article-header">
        {entry.data.example && (
          <p class="article-example font-mono text-meta text-muted-text">
            {text.example}
          </p>
        )}
        <h1
          class="article-title"
          lang={localeMetadata[entry.data.language].language}
        >
          {entry.data.title}
        </h1>
        <div
          class="article-meta font-mono"
          aria-label={locale === 'zh' ? '文章信息' : 'Article information'}
        >
          <time datetime={entry.data.publishedAt.toISOString()}>
            {dateFormatter.format(entry.data.publishedAt)}
          </time>
          {entry.data.author && (
            <span>
              {text.author}
              {entry.data.author}
            </span>
          )}
          <span>
            {stats.units.toLocaleString(localeMetadata[locale].dateLocale)}{' '}
            {text.words}
          </span>
          <span>
            {stats.minutes} {text.minutes}
          </span>
          {entry.data.tags.length > 0 && (
            <span class="article-tags">
              {entry.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </span>
          )}
        </div>
        {entry.data.updatedAt && (
          <p class="article-updated font-mono text-meta text-muted-text">
            {text.updated}{' '}
            <time datetime={entry.data.updatedAt.toISOString()}>
              {dateFormatter.format(entry.data.updatedAt)}
            </time>
          </p>
        )}
      </header>

      {entry.data.cover && (
        <figure class="article-cover">
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            widths={[680, 1020, 1360]}
            sizes="(max-width: 768px) 100vw, 680px"
          />
          {entry.data.coverAlt && (
            <figcaption>{entry.data.coverAlt}</figcaption>
          )}
        </figure>
      )}

      <Prose
        class="article-prose"
        editorial="serif"
        lang={localeMetadata[entry.data.language].language}
        data-language-block="article-body"
      >
        <Content />
      </Prose>

      <footer class="article-footer" data-language-block="article-footer">
        <a href={localizePath(sectionPaths.writing, locale)} data-astro-reload>
          <span aria-hidden="true">←</span> {text.back}
        </a>
      </footer>
    </article>
  </main>
</SiteLayout>
