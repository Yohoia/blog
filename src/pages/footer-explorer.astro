---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Footer 风格对比 · Round 03"
  description="Yohoia 品牌、版权与备案信息的五种 Footer 排版方向与交互反馈。"
  noindex
  alternateLocales={false}
  bodyClass="footer-explorer-host"
>
  <main id="main-content">
    <iframe
      src="/design-explorations/footer-round-03.html"
      title="Yohoia Footer 风格对比：现状与四种设计方向"
    ></iframe>
  </main>
</BaseLayout>

<style>
  :global(html:has(.footer-explorer-host)) {
    scrollbar-gutter: auto;
  }

  iframe {
    display: block;
    inline-size: 100%;
    block-size: 100dvh;
    border: 0;
  }
</style>
