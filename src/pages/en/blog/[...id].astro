---
import type { GetStaticPaths } from 'astro';
import ArticlePage from '@/features/blog/ArticlePage.astro';
import { getPublishedEntries } from '@/lib/content/queries';

export const getStaticPaths = (async () =>
  (await getPublishedEntries('blog')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))) satisfies GetStaticPaths;
---

<ArticlePage entry={Astro.props.entry} />
