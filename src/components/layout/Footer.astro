---
import { siteConfig } from '@/config/site';

const year = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  timeZone: siteConfig.timeZone,
}).format(new Date());
const username = siteConfig.name.toLowerCase();
---

<footer class="site-footer">
  <p class="footer-line">
    <span class="footer-prompt" aria-hidden="true">
      <span class="footer-user">{username}</span>
      <span class="footer-muted">@</span>
      <span class="footer-host">space</span>
      <span class="footer-muted">:~$</span>
    </span>
    <span class="footer-copyright">
      © {year} {siteConfig.name} ·{' '}
    </span>
    <a
      class="footer-registration"
      href={siteConfig.registration.icpUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteConfig.registration.icpNumber}
    </a>
  </p>
</footer>

<style>
  .site-footer {
    padding-block: 0;
  }

  .footer-line {
    inline-size: fit-content;
    max-inline-size: calc(100% - var(--gutter) * 2);
    min-block-size: var(--touch-target);
    margin: 0 auto;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--touch-target);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .footer-prompt {
    display: inline-block;
    margin-inline-end: 0.5rem;
    white-space: nowrap;
  }

  .footer-user {
    color: var(--terminal-user);
    font-weight: 600;
  }

  .footer-host {
    color: var(--terminal-host);
    font-weight: 600;
  }

  .footer-muted {
    color: var(--muted-text);
  }

  .footer-copyright {
    color: var(--heading);
  }

  .footer-registration {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: var(--heading);
    text-decoration: none;
    white-space: nowrap;
  }

  .footer-registration:hover,
  .footer-registration:focus-visible {
    color: var(--signal-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
