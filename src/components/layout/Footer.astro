---
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import { getLocale, localizePath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const t = ui[locale];
const year = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  timeZone: siteConfig.timeZone,
}).format(new Date());
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <a
        class="footer-name"
        href={localizePath(sectionPaths.index, locale)}
        aria-label={`${siteConfig.name} · ${t.home}`}
      >
        {siteConfig.name}
      </a>
      <p class="footer-tagline">{t.footer}</p>
    </div>
    <div class="footer-info">
      <span class="footer-copyright">
        © {year} {siteConfig.name}
      </span>
      <a
        class="footer-registration"
        href={siteConfig.registration.icpUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {siteConfig.registration.icpNumber}
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 0;
  }

  .footer-shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--inline-gap) var(--item-gap);
    inline-size: 100%;
    max-inline-size: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.65;
    text-align: start;
  }

  .footer-brand,
  .footer-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--inline-gap) * 1.5);
    min-inline-size: 0;
  }

  .footer-name {
    font-size: var(--text-item);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: var(--heading);
  }

  .footer-tagline {
    margin: 0;
    color: var(--muted-text);
    text-wrap: pretty;
  }

  .footer-info {
    margin-inline-start: auto;
    color: var(--muted-text);
  }

  .footer-copyright {
    font-variant-numeric: tabular-nums;
  }

  .footer-name,
  .footer-registration {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    max-inline-size: 100%;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-registration {
    color: inherit;
  }

  .footer-name:hover,
  .footer-name:focus-visible,
  .footer-registration:hover,
  .footer-registration:focus-visible {
    color: var(--signal-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
