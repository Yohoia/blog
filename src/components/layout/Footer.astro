---
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import { getLocale, localizePath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const t = ui[locale];
const buildDate = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: siteConfig.timeZone,
})
  .format(new Date())
  .replaceAll('-', '/');
const year = new Date(
  new Intl.DateTimeFormat('en-CA', {
    year: 'numeric',
    timeZone: siteConfig.timeZone,
  }).format(new Date()),
).getFullYear();

const siteLinks = [
  { label: t.navigation.index, href: localizePath(sectionPaths.index, locale) },
  {
    label: t.navigation.writing,
    href: localizePath(sectionPaths.writing, locale),
  },
  { label: t.navigation.news, href: localizePath(sectionPaths.news, locale) },
];
const contactLinks = [
  { label: 'GitHub', href: siteConfig.contact.github, external: true },
  {
    label: 'Email',
    href: `mailto:${siteConfig.contact.email}`,
    external: false,
  },
];
const siteNavLabel =
  locale === 'zh' ? '站点页脚导航' : 'Site footer navigation';
const contactNavLabel = locale === 'zh' ? '页脚联系方式' : 'Footer contacts';
---

<footer class="site-footer">
  <div class="footer-shell">
    <section class="footer-brand" aria-label={siteConfig.name}>
      <a class="footer-name" href={localizePath(sectionPaths.index, locale)}>
        {siteConfig.name}
      </a>
      <p class="footer-tagline">{t.footer}</p>
    </section>

    <div class="footer-meta">
      <div class="footer-meta-primary">
        <span>
          © {year} {siteConfig.name}
        </span>
        <span class="footer-separator" aria-hidden="true">
          ·
        </span>
        <span>
          {t.builtOn}
          <time datetime={buildDate}>{buildDate}</time>
        </span>
      </div>

      <nav class="footer-contact" aria-label={contactNavLabel}>
        <ul>
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external && <span aria-hidden="true">↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-secondary">
      <nav aria-label={siteNavLabel}>
        <ul>
          {siteLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="footer-timezone">{siteConfig.timeZone}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem 2.625rem;
  }

  .footer-shell {
    inline-size: 100%;
    max-inline-size: var(--container-wide);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 3rem);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-name {
    color: var(--heading);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.625;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .footer-name:hover,
  .footer-name:focus-visible {
    color: var(--signal-text);
  }

  .footer-tagline {
    margin: 0;
    color: var(--body);
    font-size: 0.8125rem;
    font-style: italic;
    line-height: 1.55;
  }

  .footer-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-start: 1.09375rem;
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    line-height: 1.5;
  }

  .footer-meta-primary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
  }

  .footer-separator {
    color: var(--muted);
    user-select: none;
  }

  .footer-contact ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-contact li + li::before {
    margin-inline-end: 0.375rem;
    color: var(--muted);
    content: '·';
  }

  .footer-contact a,
  .footer-secondary a {
    color: var(--muted-text);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible,
  .footer-secondary a:hover,
  .footer-secondary a:focus-visible {
    color: var(--signal-text);
  }

  .footer-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-start: 0.65625rem;
    padding-block-start: 0.65625rem;
    border-block-start: 1px solid var(--border);
    color: var(--muted-text);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .footer-secondary ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-secondary li + li::before {
    margin-inline-start: 0.375rem;
    color: var(--muted);
    content: '·';
  }

  .footer-timezone {
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 47.999rem) {
    .footer-meta,
    .footer-secondary {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-contact a,
    .footer-secondary a {
      transition: none;
    }
  }
</style>
