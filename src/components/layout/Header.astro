---
import { headerNavigation, sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import Logo from '@/components/common/Logo.astro';
import { getLocale, localizePath, unlocalizedPath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const text = ui[locale];
const pathname = unlocalizedPath(Astro.url.pathname);
const isCurrent = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-shell">
    <div class="header-inner">
      <Logo
        class="site-name"
        href={localizePath(sectionPaths.index, locale)}
        aria-label={`${siteConfig.name} · ${text.home}`}
        aria-current={pathname === '/' ? 'page' : undefined}
        data-navigation-transition
      />

      <nav class="nav-focus" aria-label={text.primary}>
        {headerNavigation.map(({ label, href }) => (
          <a
            href={localizePath(href, locale)}
            lang="en"
            aria-current={isCurrent(href) ? 'page' : undefined}
            data-navigation-transition
          >
            {label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    --header-padding: 1rem;
    --header-content-height: 3rem;
    --header-control-gap: 1.2rem;
    position: relative;
    z-index: 50;
  }
  .header-shell {
    padding-block: var(--header-padding);
    padding-inline: clamp(1rem, 3vw, 3rem);
    background: transparent;
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--header-control-gap);
  }
  .header-inner :global(.site-name) {
    margin-inline-end: auto;
    min-block-size: var(--header-content-height);
  }
  .nav-focus {
    display: flex;
    align-items: center;
    gap: var(--header-control-gap);
    white-space: nowrap;
  }
  .nav-focus a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--touch-target);
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0.6;
    text-decoration: none;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .nav-focus a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-focus:hover a {
      opacity: 0.25;
      filter: blur(4px);
    }
    .nav-focus a:hover {
      opacity: 1;
      filter: blur(0);
      transform: scale(1.15) translateY(-2px);
    }
  }
  .nav-focus:has(a:focus-visible) a:not(:focus-visible) {
    opacity: 0.25;
    filter: blur(4px);
  }
  .nav-focus a:focus-visible {
    opacity: 1;
    filter: blur(0);
    transform: scale(1.15) translateY(-2px);
  }
  @media (max-width: 42rem) {
    .site-header {
      --header-padding: 0.75rem;
    }
    .header-inner {
      row-gap: 0.25rem;
    }
    .header-inner :global(.site-name) {
      flex-basis: 100%;
    }
    .nav-focus {
      flex-basis: 100%;
      gap: 0.25rem;
      min-inline-size: 0;
    }
    .nav-focus a:hover,
    .nav-focus a:focus-visible {
      transform: none;
    }
  }
  @media (max-width: 24rem) {
    .header-shell {
      padding-inline: 0.75rem;
    }
    .header-inner {
      row-gap: var(--inline-gap);
    }
    .header-inner :global(.site-name) {
      --logo-width: 6.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-focus a {
      transition: opacity 0.2s ease;
    }
    .nav-focus a:hover,
    .nav-focus a:focus-visible {
      transform: none;
    }
  }
</style>
