---
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import Logo from '@/components/common/Logo.astro';
import LanguageToggle from '@/components/ui/LanguageToggle.astro';
import TypeOverlayMenu from './TypeOverlayMenu.astro';
import { getLocale, localizePath, unlocalizedPath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const text = ui[locale];
const pathname = unlocalizedPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="header-shell">
    <div class="header-inner">
      <Logo
        class="site-name"
        href={localizePath(sectionPaths.index, locale)}
        aria-label={`${siteConfig.name} · ${text.home}`}
        aria-current={pathname === '/' ? 'page' : undefined}
        data-navigation-transition
      />

      <div class="header-actions">
        <TypeOverlayMenu />
        <LanguageToggle />
        <ThemeToggle class="header-theme-toggle" />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    --header-padding: 1rem;
    --header-content-height: 3rem;
    position: relative;
    z-index: 50;
  }
  .header-shell {
    padding-block: var(--header-padding);
    padding-inline: clamp(1rem, 3vw, 3rem);
    background: var(--header-surface);
    -webkit-backdrop-filter: blur(var(--header-blur))
      saturate(var(--header-saturation));
    /* 标准属性置于前缀之后，防止构建压缩只保留旧前缀。 */
    backdrop-filter: blur(var(--header-blur)) saturate(var(--header-saturation));
    border-block-end: 1px solid transparent;
  }
  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--item-gap);
  }
  .header-inner :global(.site-name) {
    justify-self: start;
    min-block-size: var(--header-content-height);
  }
  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .header-actions :global(.header-theme-toggle) {
    border-radius: var(--radius-pill);
  }
  @media (max-width: 59.999rem) {
    .site-header {
      --header-padding: 0.75rem;
    }
  }
  @media (max-width: 24rem) {
    .header-inner {
      gap: var(--inline-gap);
    }
    .header-inner :global(.site-name) {
      --logo-width: 6.25rem;
    }
  }
</style>
