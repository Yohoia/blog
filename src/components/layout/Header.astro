---
import { sectionPaths } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import Logo from '@/components/common/Logo.astro';
import LanguageToggle from '@/components/ui/LanguageToggle.astro';
import TypeOverlayMenu from './TypeOverlayMenu.astro';
import { getLocale, localizePath, unlocalizedPath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const text = ui[locale];
const pathname = unlocalizedPath(Astro.url.pathname);
---

<site-navigation class="site-navigation">
  <header class="site-header">
    <div class="header-shell">
      <div class="header-inner">
        <Logo
          class="site-name"
          href={localizePath(sectionPaths.index, locale)}
          aria-label={`${siteConfig.name} · ${text.home}`}
          aria-current={pathname === '/' ? 'page' : undefined}
          data-navigation-transition
        />

        <div class="header-actions">
          <TypeOverlayMenu />
          <LanguageToggle />
          <ThemeToggle class="header-theme-toggle" />
        </div>
      </div>
    </div>
  </header>
</site-navigation>

<script>
  import { registerNavigation } from '@/scripts/navigation';
  registerNavigation();
</script>

<style>
  .site-navigation {
    --header-padding: 1.5rem;
    --header-compact-padding: 0.75rem;
    --header-content-height: 3rem;
    --header-expansion: 1;
    display: block;
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    /* 保留文档中的高度，滚动收紧时不会推移正文或触发滚动抖动。 */
    block-size: calc(
      var(--header-content-height) + var(--header-padding) * 2 + 1px
    );
  }
  .site-header {
    position: absolute;
    inset: 0 0 auto;
  }
  .header-shell {
    padding-block: calc(
      var(--header-compact-padding) +
        (var(--header-padding) - var(--header-compact-padding)) *
        var(--header-expansion)
    );
    padding-inline: clamp(var(--gutter), 4vw, 4rem);
    background: transparent;
    border-block-end: 1px solid transparent;
  }
  .site-navigation[data-scrolled] .header-shell {
    background: color-mix(in srgb, var(--canvas) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    /* 标准属性置于前缀之后，防止构建压缩只保留旧前缀。 */
    backdrop-filter: blur(12px);
    border-color: var(--border);
  }
  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--item-gap);
  }
  .header-inner :global(.site-name) {
    justify-self: start;
    min-block-size: var(--header-content-height);
  }
  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .header-actions :global(.header-theme-toggle) {
    border-radius: var(--radius-pill);
  }
  @media (max-width: 59.999rem) {
    .site-navigation {
      --header-padding: 1rem;
      --header-compact-padding: 0.5rem;
    }
  }
  @media (max-width: 24rem) {
    .header-inner {
      gap: var(--inline-gap);
    }
    .header-inner :global(.site-name) {
      --logo-width: 6.25rem;
    }
  }
</style>
