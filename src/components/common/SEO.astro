---
import { siteConfig } from '@/config/site';
import { localeMetadata } from '@/config/i18n';
import { getLocale, localizePath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}

const locale = getLocale(Astro.url.pathname);
const {
  title,
  description = ui[locale].description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedAt,
  updatedAt,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage =
  image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical.href} />}
{Astro.site &&
  !noindex &&
  (['zh', 'en'] as const).map((language) => (
    <link
      rel="alternate"
      hreflang={localeMetadata[language].language}
      href={
        new URL(localizePath(Astro.url.pathname, language), Astro.site).href
      }
    />
  ))}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={localeMetadata[locale].ogLocale} />
{canonical && <meta property="og:url" content={canonical.href} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{type === 'article' && publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{type === 'article' && updatedAt && (
  <meta property="article:modified_time" content={updatedAt.toISOString()} />
)}
<meta
  name="twitter:card"
  content={ogImage ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
