---
import { Languages } from '@lucide/astro';
import { iconTokens } from '@/config/icons';
import { localeMetadata } from '@/config/i18n';
import { getLocale, localizePath } from '@/lib/i18n';
import { ui } from '@/i18n/ui';

const locale = getLocale(Astro.url.pathname);
const target = locale === 'zh' ? 'en' : 'zh';
const href = localizePath(Astro.url.pathname, target);
---

<a
  href={href}
  class="ui-button language-toggle"
  data-icon-only
  data-language-toggle
  lang={localeMetadata[target].language}
  hreflang={localeMetadata[target].language}
  aria-label={ui[locale].switchLanguage}
  title={ui[locale].switchLanguage}
>
  <Languages
    size={iconTokens.size.normal}
    stroke-width={iconTokens.strokeWidth}
    aria-hidden="true"
  />
</a>

<script>
  import { initializeLanguageNavigation } from '@/scripts/language';
  initializeLanguageNavigation();
</script>

<style>
  .language-toggle {
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
</style>
