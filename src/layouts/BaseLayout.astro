---
import SEO, { type Props as SEOProps } from '@/components/common/SEO.astro';
import ThemeInit from '@/components/common/ThemeInit.astro';
import NavigationTransition from '@/components/common/NavigationTransition.astro';
import { localeMetadata } from '@/config/i18n';
import { getLocale } from '@/lib/i18n';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props extends SEOProps {
  bodyClass?: string;
  hideScrollbar?: boolean;
}

const { bodyClass, hideScrollbar = false, ...seo } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<!doctype html>
<html
  lang={localeMetadata[locale].language}
  class:list={{ 'scrollbar-hidden': hideScrollbar }}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <ClientRouter fallback="swap" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <NavigationTransition />
    <script>
      import '@/scripts/page-visit';
      import { initializeTheme } from '@/scripts/theme';
      initializeTheme();
    </script>
  </body>
</html>
